{
  "log": {
    "loglevel": "none",
    "access": "none",
    "error": "none"
  },
  "inbounds": [
    {
      "port": 8080,
      "protocol": "vless",
      "settings": {
        "decryption": "none",
        "clients": [
          {
            "id": "YOUR_UUID",
            "email": "native-user",
            "flow": ""
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "none",
        "wsSettings": {
          "host": "",
          "path": "/"
        }
      }
    },
    {
      "port": 18080,
      "protocol": "hysteria",
      "settings": {
        "clients": [
          {
            "auth": "YOUR_UUID",
            "email": "native-user"
          }
        ],
        "version": 2
      },
      "streamSettings": {
        "finalmask": {
          "udp": [
            {
              "settings": {
                "stunServers": [
                  "stun.nextcloud.com:3478",
                  "global.stun.twilio.com:3478"
                ],
                "url": "realm://public@realm.hy2.io/YOUR_UUID"
              },
              "type": "realm"
            }
          ]
        },
        "hysteriaSettings": {
          "version": 2
        },
        "network": "hysteria",
        "security": "tls",
        "tlsSettings": {
          "alpn": [
            "h3"
          ],
          "certificates": [
            {
              "certificateFile": "/etc/xy/cert.pem",
              "keyFile": "/etc/xy/key.pem"
            }
          ],
          "serverName": "www.bing.com",
          "minVersion": "1.3",
          "maxVersion": "1.3"
        }
      }
    }
  ],
  "routing": {
    "rules": [
      {
        "type": "field",
        "domain": [
          "v.com"
        ],
        "outboundTag": "force-to-ip"
      }
    ]
  },
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "force-to-ip",
      "protocol": "freedom",
      "settings": {
        "redirect": "127.0.0.1:0",
        "finalRules": [
          {
            "action": "allow"
          }
        ]
      }
    }
  ]
}
